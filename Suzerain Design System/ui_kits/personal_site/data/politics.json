{
  "updated": "2026-08-07",
  "note": "Sympathies, not projections.",
  "_schema": {
    "key": "match a feature by name (as spelled in geo-world.json / geo-us.json) or by its numeric id",
    "races": "[{ office, next, pick, enthusiasm, note, tier? }] — one entry per contest",
    "office": "what's being contested — free text; the tier is read off it",
    "tier": "optional override: executive | legislature | governor. Otherwise inferred from the office name",
    "rank": "optional number that overrides the computed rank outright — last resort when the office keywords sort a race wrongly",
    "next": "ISO date of the election, or null if unscheduled",
    "pick": "who i'd support — free text. 'none' is a real answer",
    "enthusiasm": "enthusiastic | qualified | tactical",
    "note": "one line, why",
    "past": "[{ date, office, pick, enthusiasm, note }] — earlier reads, oldest first",
    "_priority": "Soonest race leads — it colours the map and heads the overlay. Rank only settles a shared date: executive (president/PM/chancellor) > legislature > governor. Within the legislature, the US ranks senate above house; parliamentary systems rank the lower house (commons/bundestag/lok sabha) above the upper.",
    "logged": "ISO date the endorsement was made — stamped by scripts/politics/stamp-logged.py when the pick changes, not hand-written. Changing enthusiasm on the same pick leaves it alone"
  },
